{
  "name": "watsonhaw/lychee-php-project",
  "description": "Lychee PHP 应用模板",
  "type": "project",
  "license": "MIT",
  "keywords": [
    "lychee",
    "php",
    "framework",
    "skeleton",
    "project"
  ],
  "homepage": "https://github.com/watsonhaw5566/lychee-php-project",
  "require": {
    "php": "^8.2",
    "watsonhaw/lychee-php": "^0.5"
  },
  "autoload": {
    "psr-4": {
      "App\\": "app/"
    }
  },
  "config": {
    "optimize-autoloader": true,
    "sort-packages": true
  },
  "scripts": {
    "post-root-package-install": [
      "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
    ]
  },
  "repositories": [
    {
      "type": "path",
      "url": "/Users/wangjue/PhpstormProjects/ant/lychee-php",
      "options": {
        "symlink": true
      }
    }
  ]
}
