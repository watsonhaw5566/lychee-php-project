{
  "name": "watsonhaw/lychee-php-project",
  "description": "Lychee PHP project",
  "type": "project",
  "license": "MIT",
  "keywords": [
    "lychee",
    "php",
    "framework",
    "skeleton",
    "project"
  ],
  "homepage": "https://github.com/watsonhaw5566/lychee-php-project",
  "require": {
    "php": "^8.2",
    "phpoffice/phpspreadsheet": "^5.10",
    "watsonhaw/lychee-php": "^0.7"
  },
  "require-dev": {
    "friendsofphp/php-cs-fixer": "^3.95",
    "phpstan/phpstan": "^2.1",
    "phpunit/phpunit": "^12.0"
  },
  "autoload": {
    "psr-4": {
      "app\\": "app/",
      "test\\": "test/"
    }
  },
  "config": {
    "optimize-autoloader": true,
    "sort-packages": true
  },
  "scripts": {
    "post-root-package-install": [
      "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
    ],
    "test": "phpunit",
    "analyze": "phpstan --no-progress --memory-limit=1G",
    "fix-style": "php-cs-fixer fix",
    "check-style": "php-cs-fixer fix --dry-run"
  }
}